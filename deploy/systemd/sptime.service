# SPTime Systemd Service Unit
# Install to: /etc/systemd/system/sptime.service
# Enable with: systemctl enable sptime
# Start with: systemctl start sptime

[Unit]
Description=SPTime - Precision Time Synchronization Platform
Documentation=https://github.com/sptime/sptime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sptime
Group=sptime

# Working directory
WorkingDirectory=/opt/sptime

# Main process
ExecStart=/opt/sptime/sptime -config /etc/sptime/config.yaml

# Restart policy
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# Allow binding to privileged ports (NTP: 123)
AmbientCapabilities=CAP_NET_BIND_SERVICE

# For PTP, may also need:
# AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_SYS_TIME

# Allow reading PPS device
DeviceAllow=/dev/pps0 r

# Read-write paths
ReadWritePaths=/var/lib/sptime /var/log/sptime

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sptime

# Resource limits
LimitNOFILE=65536
MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
